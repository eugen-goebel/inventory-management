# Copy this file to .env and adjust the values. The backend loads it on
# startup, and real environment variables take precedence over it, which is
# how docker-compose passes DATABASE_URL.

# Set to "production" for a real deployment. The backend then refuses to
# start unless JWT_SECRET_KEY is set to something other than the default,
# instead of silently signing tokens with a key that is public.
APP_ENV=development

# JWT authentication secret. Required when APP_ENV=production.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes (default: 60)
JWT_EXPIRE_MINUTES=60

# Database location (default: backend/inventory.db)
# DATABASE_URL=sqlite:///inventory.db
