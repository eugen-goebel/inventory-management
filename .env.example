# Copy this file to .env and adjust the values. The backend loads it on
# startup, and real environment variables take precedence over it, which is
# how docker-compose passes DATABASE_URL.

# JWT authentication secret — change this in production
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes (default: 60)
JWT_EXPIRE_MINUTES=60

# Database location (default: backend/inventory.db)
# DATABASE_URL=sqlite:///inventory.db
